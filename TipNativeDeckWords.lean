import Std
import TipNativeRootDeck

/-!
# Finite free-word controls for the native KL root-deck selector

The November 9 native-root audit requires the *actual based connector
word* in the nine-obstacle free group before any source lift can be
classified. Winding numbers alone are not a membership test.

This module supplies an executable cancellation normalizer and finite
kernel-checked positive/negative controls. It does NOT supply the
missing geometric cut-crossing word of a physical KL connector, nor
prove the full analytic root-convergence/prime-end theorem.

The all-integer uniqueness from abelianized winding is already proved
in TipNativeRootDeck.lean; this module checks the strictly stronger
nonabelian membership obstruction visible in a commutator.
-/

namespace LoopsFormal.TipNativeDeckWords

structure Letter where
  generator : Fin 9
  inverse : Bool
  deriving BEq, DecidableEq, Repr

abbrev Word := List Letter

def pos (g : Fin 9) : Letter := ⟨g, false⟩

def flip (a : Letter) : Letter := ⟨a.generator, !a.inverse⟩

def b00 : Letter := pos 0
def b01 : Letter := pos 1
def b02 : Letter := pos 2

/-- Stack-style free cancellation, reducing each suffix before the
    next leading symbol is incorporated. -/
def reduce : Word → Word
  | [] => []
  | a :: rest =>
      match reduce rest with
      | [] => [a]
      | b :: tail =>
          if flip a == b then tail else a :: b :: tail

/-- Syntactic membership test in the cyclic subgroup generated by b00:
    all symbols in the reduced word must be b00 or its inverse. -/
def rootCyclicWord (w : Word) : Bool :=
  (reduce w).all (fun a => a.generator == (0 : Fin 9))

/-- Raw signed abelianization at the generator j. This is weaker
    than the exact nonabelian reduction test. -/
def winding (j : Fin 9) : Word → Int
  | [] => 0
  | a :: rest =>
      (if a.generator == j then
        if a.inverse then -1 else 1
       else 0) + winding j rest

/-- Fixed based coarse meridian in the archive: beta0=b00 b01 b02. -/
def beta0 : Word := [b00, b01, b02]

def beta0Inverse : Word := [flip b02, flip b01, flip b00]

theorem coarse_meridian_inverse_cancels :
    reduce (beta0 ++ beta0Inverse) = [] := by
  decide +kernel

/-- Every abelianized winding vanishes, despite a nontrivial word. -/
def commutator : Word := [b01, b02, flip b01, flip b02]

theorem commutator_is_freely_reduced :
    reduce commutator = commutator := by
  decide +kernel

theorem commutator_has_zero_winding_in_all_nine_generators :
    ∀ j : Fin 9, winding j commutator = 0 := by
  decide +kernel

theorem zero_winding_is_not_root_subgroup_membership :
    rootCyclicWord commutator = false := by
  decide +kernel

/-- Synthetic *based* connector with g=beta0^(-2)*b00^3.
    It is a positive test for the candidate shift n=2.
    No assertion is made that it is a physical KL connector. -/
def twoTurnDefect : Word :=
  beta0Inverse ++ beta0Inverse ++ [b00, b00, b00]

theorem known_based_defect_has_forced_shift_two :
    winding 1 twoTurnDefect = -2 ∧
    winding 2 twoTurnDefect = -2 ∧
    rootCyclicWord (beta0 ++ beta0 ++ twoTurnDefect) = true := by
  decide +kernel

/-- An unshifted positive root-subgroup control. -/
theorem root_subgroup_positive_control :
    rootCyclicWord [b00, b00, flip b00, b00] = true := by
  decide +kernel

#print axioms coarse_meridian_inverse_cancels
#print axioms commutator_has_zero_winding_in_all_nine_generators
#print axioms zero_winding_is_not_root_subgroup_membership
#print axioms known_based_defect_has_forced_shift_two

end LoopsFormal.TipNativeDeckWords

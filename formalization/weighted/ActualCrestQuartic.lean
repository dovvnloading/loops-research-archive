import ActualCrestRemainderScale
import TwoLevelPerturbation

/-!
# A complete quartic profile for the actual normalized return

The coefficient below is generated by the exact squaring recurrence.
After retaining it, the entire remaining polynomial is bounded at the
next exponential order. The estimate is uniform on a complex disk and
does not assume a Taylor approximation to the actual return.
-/

namespace ActualCrestQuartic

open Set Function
open LimitingCrest LimitingCrestQuadraticReturn NearTwoShooting NearTwoTip

noncomputable section

set_option maxHeartbeats 1000000

/-- The coefficient of degree four in the complete `(n+1)`-st iterate. -/
def quarticCoefficient (c : ℝ) : ℕ → ℝ
  | 0 => 0
  | n+1 => 2*criticalValue c (n+1)*quarticCoefficient c n +
      (quadraticCoefficient c n)^2

/-- Every term beyond the quartic part of the actual polynomial. -/
def quarticRemainder (c : ℝ) (n : ℕ) (z : ℂ) : ℂ :=
  quadraticRemainder c n z - (quarticCoefficient c n : ℂ)*z^4

/-- The actual quartic coefficient in critical-return units. -/
def normalizedQuartic (c : ℝ) (p : ℕ) : ℝ :=
  quarticCoefficient c (p-1)*(criticalValue c p)^3

theorem quartic_remainder_step (c : ℝ) (n : ℕ) (z : ℂ) :
    quarticRemainder c (n+1) z =
      2*(criticalValue c (n+1) : ℂ)*quarticRemainder c n z +
      2*((quadraticCoefficient c n : ℂ)*z^2)*quadraticRemainder c n z +
      (quadraticRemainder c n z)^2 := by
  simp only [quarticRemainder, quarticCoefficient, quadraticRemainder,
    iterate_succ_apply', quadraticMap, criticalValue_step, quadraticCoefficient]
  push_cast
  ring

/-- The full higher-order remainder has a cubic small-disk budget.
In particular it contains every term of degree at least six. -/
theorem complete_quartic_remainder_bound (c : ℝ) (n : ℕ) :
    ∀ (r : ℝ) (z : ℂ), 0 ≤ r →
      (∀ j : ℕ, j ≤ n+1 → |criticalValue c j| ≤ 2) →
      (4 : ℝ)^(n+1)*r^2 ≤ 1 → ‖z‖ ≤ r →
      ‖quarticRemainder c n z‖ ≤ ((4 : ℝ)^(n+1)*r^2)^3/8192 := by
  induction n with
  | zero =>
    intro r z hr hcrit hscale hz
    have he : quarticRemainder c 0 z = 0 := by
      simp [quarticRemainder, quarticCoefficient, quadraticRemainder,
        quadraticMap, criticalValue, quadraticCoefficient]
    rw [he, norm_zero]
    positivity
  | succ n ih =>
    intro r z hr hcrit hscale hz
    let t : ℝ := (4 : ℝ)^(n+1)*r^2
    have ht0 : 0 ≤ t := by dsimp [t]; positivity
    have hnext : (4 : ℝ)^(n+1+1)*r^2 = 4*t := by
      dsimp [t]
      rw [pow_succ]
      ring
    have ht : t ≤ 1/4 := by rw [hnext] at hscale; linarith
    have hprevious : ∀ j : ℕ, j ≤ n+1 → |criticalValue c j| ≤ 2 :=
      fun j hj => hcrit j (by omega)
    have hbudget : (4 : ℝ)^(n+1)*r^2 ≤ 1 := by change t ≤ 1; linarith
    have hhigh := ih r z hr hprevious hbudget hz
    change ‖quarticRemainder c n z‖ ≤ t^3/8192 at hhigh
    have hrem := complete_remainder_bound c n r z hr hprevious hbudget hz
    change ‖quadraticRemainder c n z‖ ≤ t^2/128 at hrem
    have hrem' : ‖quadraticRemainder c n z‖ ≤ t/512 := by
      have hm := mul_le_mul_of_nonneg_left ht ht0
      nlinarith only [hrem, hm]
    have ha := TwoLevelPerturbation.coefficient_bound c n hprevious
    have hz2 := pow_le_pow_left₀ (norm_nonneg z) hz 2
    have hlead : ‖(quadraticCoefficient c n : ℂ)*z^2‖ ≤ t/4 := by
      calc
        ‖(quadraticCoefficient c n : ℂ)*z^2‖ =
            |quadraticCoefficient c n|*‖z‖^2 := by
          rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs]
        _ ≤ (4 : ℝ)^n*r^2 :=
          mul_le_mul ha hz2 (sq_nonneg _) (by positivity)
        _ = t/4 := by dsimp [t]; rw [pow_succ]; ring
    have hlinear : ‖2*(criticalValue c (n+1) : ℂ)*quarticRemainder c n z‖ ≤
        t^3/2048 := by
      rw [norm_mul, norm_mul, Complex.norm_two, Complex.norm_real, Real.norm_eq_abs]
      calc
        (2*|criticalValue c (n+1)|)*‖quarticRemainder c n z‖ ≤ 4*(t^3/8192) :=
          mul_le_mul (by linarith [hcrit (n+1) (by omega)]) hhigh
            (norm_nonneg _) (by norm_num)
        _ = t^3/2048 := by ring
    have hcross : ‖2*((quadraticCoefficient c n : ℂ)*z^2)*
        quadraticRemainder c n z‖ ≤ t^3/256 := by
      rw [norm_mul, norm_mul, Complex.norm_two]
      calc
        (2*‖(quadraticCoefficient c n : ℂ)*z^2‖)*‖quadraticRemainder c n z‖ ≤
            (2*(t/4))*(t^2/128) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hlead (by norm_num)) hrem
            (norm_nonneg _) (by positivity)
        _ = t^3/256 := by ring
    have hsquare : ‖(quadraticRemainder c n z)^2‖ ≤ t^3/65536 := by
      rw [norm_pow, pow_two]
      calc
        ‖quadraticRemainder c n z‖*‖quadraticRemainder c n z‖ ≤
            (t/512)*(t^2/128) :=
          mul_le_mul hrem' hrem (norm_nonneg _) (by positivity)
        _ = t^3/65536 := by ring
    rw [hnext, quartic_remainder_step]
    calc
      ‖2*(criticalValue c (n+1) : ℂ)*quarticRemainder c n z +
          2*((quadraticCoefficient c n : ℂ)*z^2)*quadraticRemainder c n z +
          (quadraticRemainder c n z)^2‖ ≤
          ‖2*(criticalValue c (n+1) : ℂ)*quarticRemainder c n z‖ +
          ‖2*((quadraticCoefficient c n : ℂ)*z^2)*quadraticRemainder c n z‖ +
          ‖(quadraticRemainder c n z)^2‖ :=
        (norm_add_le _ _).trans (add_le_add (norm_add_le _ _) le_rfl)
      _ ≤ t^3/2048+t^3/256+t^3/65536 :=
        add_le_add (add_le_add hlinear hcross) hsquare
      _ ≤ (4*t)^3/8192 := by nlinarith only [pow_nonneg ht0 3]

theorem normalized_quartic_identity {p : ℕ} (hp : 1 ≤ p) {c : ℝ}
    (hd : criticalValue c p ≠ 0) (z : ℂ) :
    normalizedReturn c p z -
        (complexMap (kappa p c) z + (normalizedQuartic c p : ℂ)*z^4) =
      quarticRemainder c (p-1) ((criticalValue c p : ℂ)*z) /
        (criticalValue c p : ℂ) := by
  have hdC : (criticalValue c p : ℂ) ≠ 0 := by exact_mod_cast hd
  unfold normalizedReturn complexMap kappa normalizedQuartic
    quarticRemainder quadraticRemainder
  rw [show p-1+1=p by omega]
  push_cast
  field_simp [hdC]
  <;> ring

/-- The complete actual return has a quartic profile with a uniform
second-order exponential error on the full complex approximation disk. -/
theorem normalized_quartic_error {p : ℕ} (hp : 17 ≤ p) {c : ℝ}
    (hc : ActualTip p c) {z : ℂ} (hz : ‖z‖ ≤ 3/2) :
    ‖normalizedReturn c p z -
      (complexMap (kappa p c) z + (normalizedQuartic c p : ℂ)*z^4)‖ ≤
      400*(scale p)^2 := by
  let d : ℝ := criticalValue c p
  let S : ℝ := (4 : ℝ)^p
  let R : ℝ := 3/2
  have hd : 0 < d := hc.2.1
  have hS : 0 < S := by dsimp [S]; positivity
  have hSq : S*scale p = 1 := by
    simpa only [S,mul_comm] using TwoLevelPerturbation.scale_mul_power p
  have hSd : S*d ≤ 12 := by
    have hm := mul_le_mul_of_nonneg_left hc.2.2.1 hS.le
    change S*d ≤ S*(12*scale p) at hm
    nlinarith only [hm,hSq]
  have hSd0 : 0 ≤ S*d := mul_nonneg hS.le hd.le
  have hSbig : 17179869184 ≤ S := by
    have h := pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 4) hp
    norm_num at h
    exact h
  have hbudget : S*(d*R)^2 ≤ 1 := by
    have hsq := pow_le_pow_left₀ hSd0 hSd 2
    have he : S*(S*(d*R)^2) = (S*d)^2*R^2 := by ring
    have hm := mul_le_mul_of_nonneg_right hsq (sq_nonneg R)
    have hl := mul_le_mul_of_nonneg_right hSbig
      (show 0 ≤ S*(d*R)^2 by positivity)
    dsimp [R] at he hm hl ⊢
    nlinarith only [he,hm,hl]
  have hinput : ‖(d : ℂ)*z‖ ≤ d*R := by
    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hd]
    exact mul_le_mul_of_nonneg_left hz hd.le
  have herr := complete_quartic_remainder_bound c (p-1) (d*R) ((d : ℂ)*z)
    (by positivity) (fun j hj => hc.2.2.2.2.2.2 j (by omega))
    (by simpa only [show p-1+1=p by omega] using hbudget) hinput
  rw [show p-1+1=p by omega] at herr
  change ‖quarticRemainder c (p-1) ((d : ℂ)*z)‖ ≤ (S*(d*R)^2)^3/8192 at herr
  have hp5 := pow_le_pow_left₀ hSd0 hSd 5
  have hnorm : ((S*(d*R)^2)^3/8192)*S^2 = (S*d)^5*d*R^6/8192 := by ring
  have hnum : (12 : ℝ)^5*(3/2)^6/8192 ≤ 400 := by norm_num
  have hbound : (S*(d*R)^2)^3/8192/d ≤ 400/S^2 := by
    apply (div_le_div_iff₀ hd (sq_pos_of_pos hS)).mpr
    rw [hnorm]
    calc
      (S*d)^5*d*R^6/8192 ≤ 12^5*d*R^6/8192 :=
        div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hp5 hd.le)
            (by positivity)) (by norm_num)
      _ = (12^5*(3/2)^6/8192)*d := by dsimp [R]; ring
      _ ≤ 400*d := mul_le_mul_of_nonneg_right hnum hd.le
  rw [normalized_quartic_identity (by omega) hc.2.1.ne',
    norm_div,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hc.2.1]
  have he : (400 : ℝ)/S^2 = 400*(scale p)^2 := by
    simp only [S,scale,one_div_pow,div_pow]
    ring
  exact (div_le_div_of_nonneg_right herr hd.le).trans (hbound.trans_eq he)

end
end ActualCrestQuartic

/-- Kernel verification of every exclusion and every covering split. -/
theorem cover6_checked :
    coverCheck tipScale 6 ⟨-2 * tipScale, 0⟩ seed6 cover6 = true := by
  decide +kernel

/-- Opposite endpoint signs and a strict derivative bound on the entire interval. -/
theorem seed6_root : RootCertificate tipScale 6 seed6 := by
  decide +kernel

/-- Every intermediate critical iterate has the prescribed strict sign. -/
theorem seed6_signs : signBoxCheck tipScale 6 seed6 = true := by
  decide +kernel

/-- The endpoint return stays strictly above the reflected critical value. -/
theorem seed6_invariant :
    0 < (addBounds (orbitBound tipScale 6 seed6 6)
      (orbitBound tipScale 6 seed6 12)).lo := by
  decide +kernel

/-- The root interval lies strictly inside the globally covered parameter interval. -/
theorem seed6_inside : -2 * tipScale < seed6.lo ∧ seed6.hi < 0 := by
  decide +kernel

end LoopsGlobalTip

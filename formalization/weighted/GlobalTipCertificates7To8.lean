/-- Kernel verification of every exclusion and every covering split. -/
theorem cover8_checked :
    coverCheck tipScale 8 ⟨-2 * tipScale, 0⟩ seed8 cover8 = true := by
  decide +kernel

/-- Opposite endpoint signs and a strict derivative bound on the entire interval. -/
theorem seed8_root : RootCertificate tipScale 8 seed8 := by
  decide +kernel

/-- Every intermediate critical iterate has the prescribed strict sign. -/
theorem seed8_signs : signBoxCheck tipScale 8 seed8 = true := by
  decide +kernel

/-- The endpoint return stays strictly above the reflected critical value. -/
theorem seed8_invariant :
    0 < (addBounds (orbitBound tipScale 8 seed8 8)
      (orbitBound tipScale 8 seed8 16)).lo := by
  decide +kernel

/-- The root interval lies strictly inside the globally covered parameter interval. -/
theorem seed8_inside : -2 * tipScale < seed8.lo ∧ seed8.hi < 0 := by
  decide +kernel

end LoopsGlobalTip

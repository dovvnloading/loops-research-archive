/-- Kernel verification of every exclusion and every covering split. -/
theorem cover10_checked :
    coverCheck tipScale 10 ⟨-2 * tipScale, 0⟩ seed10 cover10 = true := by
  decide +kernel

/-- Opposite endpoint signs and a strict derivative bound on the entire interval. -/
theorem seed10_root : RootCertificate tipScale 10 seed10 := by
  decide +kernel

/-- Every intermediate critical iterate has the prescribed strict sign. -/
theorem seed10_signs : signBoxCheck tipScale 10 seed10 = true := by
  decide +kernel

/-- The endpoint return stays strictly above the reflected critical value. -/
theorem seed10_invariant :
    0 < (addBounds (orbitBound tipScale 10 seed10 10)
      (orbitBound tipScale 10 seed10 20)).lo := by
  decide +kernel

/-- The root interval lies strictly inside the globally covered parameter interval. -/
theorem seed10_inside : -2 * tipScale < seed10.lo ∧ seed10.hi < 0 := by
  decide +kernel

end LoopsGlobalTip

{
  "name": "loops-fractal-research-engine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "python3 scripts/prepare_data.py && tsc -b && vite build && python3 scripts/copy_archive.py",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run build && npm test && python3 code/verify_site_integrity.py",
    "predev": "python3 scripts/prepare_data.py",
    "pretest": "python3 scripts/prepare_data.py",
    "format:check": "prettier --check src/App.tsx src/studio src/precision src/journal src/laboratory src/research/ResearchOverview.tsx src/research/research-overview.css",
    "test:browser": "node scripts/smoke_webgl.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}

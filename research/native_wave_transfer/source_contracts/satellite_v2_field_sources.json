    "DLS2": "Dudko, Lyubich and Selinger, Pacman Renormalization and Self-Similarity of the Mandelbrot Set near Siegel Parameters, JAMS 33 (2020), Definition 2.1 and \u00a7\u00a72.1\u20132.2 (sector cuts, glued arcs), Appendix C (molecule): https://doi.org/10.1090/jams/942",
    "DS2": "Dudko and Schleicher, Core Entropy of Quadratic Polynomials, Arnold Math. J. 6 (2020), \u00a72, discussion after Definition 2.2 and Lemma 2.3 (finite Hubbard-tree Markov edges, incidence and spectral radius): https://doi.org/10.1007/s40598-020-00134-y",
    "EXACT": "Existing immutable research/native_wave_transfer/physical_examples/satellite2_misiurewicz_tip_refusal.json and exact return proof in regenerate_satellite2_tip.py; independently recertified in regenerate_satellite_v2.py (local field definitions; not attributed to a paper)",
    "KKL": "Kahn, Kapiamba and Lyubich, MLC for parabolically bounded primitive renormalization, arXiv:2606.27272v1, \u00a7\u00a72.3\u20132.5, \u00a76.1 Props. 6.5\u20136.6, Appendix A.1/A.3.2\u2013A.3.4 (primitive path, ideal access, Wave): https://arxiv.org/abs/2606.27272v1",
    "KL22": "Kahn and Lyubich, A priori bounds for some infinitely renormalizable quadratics: III. Molecules (2007), \u00a7\u00a71, 2.2 (molecule/primitive scope): https://arxiv.org/abs/0712.2444",
    "LY91": "Lyubich, Dynamics of Quadratic Polynomials I\u2013II, Part II \u00a79.1 (little Julia bouquets touching at periodic beta points): https://www.math.stonybrook.edu/~mlyubich/Archive/Selected/puzzle.pdf",
    "OPEN": "Explicit absence of a satellite-native KKL proper-endpoint filtration/Wave-transfer statement in AL \u00a72.10, KL \u00a72.2, DLS \u00a7\u00a72.1\u20132.2 and KKL \u00a7\u00a72.3\u20132.5, \u00a76.1, Appendix A; this is a scope declaration, not a theorem",
    "PRIM": "Existing immutable research/native_wave_transfer/experiment_manifests/tip_pr68.json and primitive4_tip12.json, v1 SPECIFICATION.md \u00a7\u00a72\u20135 (comparison only)"
